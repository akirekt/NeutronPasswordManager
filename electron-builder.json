{
  "appId": "com.neutron.passwordmanager",
  "productName": "Neutron Password Manager",
  "directories": {
    "output": "dist-release"
  },
  "files": [
    "dist/**",
    "dist-electron/**"
  ],
  "extraResources": [
    {
      "from": "public/icon.ico",
      "to": "icon.ico"
    }
  ],
  "win": {
    "target": [
      {
        "target": "dir",
        "arch": [
          "x64"
        ]
      }
    ],
    "icon": "public/icon.ico"
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true
  }
}
